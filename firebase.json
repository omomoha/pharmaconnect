{
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "dist/index.js",
        "dist/index.js.map",
        "dist/index.d.ts",
        "dist/index.d.ts.map",
        "dist/app.js",
        "dist/app.js.map",
        "dist/app.d.ts",
        "dist/app.d.ts.map",
        "dist/__tests__",
        "dist/scripts",
        "jest.config.ts",
        ".env",
        ".env.*",
        "*.md",
        "tsconfig.json"
      ],
      "predeploy": [
        "cd shared && npm run build && cd ..",
        "rm -rf backend/_shared && mkdir -p backend/_shared && cp -r shared/dist shared/package.json backend/_shared/",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
