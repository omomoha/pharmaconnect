rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ========== HELPER FUNCTIONS ==========
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'platform_admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate file size (max 10MB)
    function isValidFileSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Validate image content type
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Validate document content type (images + PDFs)
    function isDocument() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    // Helper: check if user has pharmacy_admin role
    function isPharmacyAdmin() {
      return isAuthenticated() && request.auth.token.role == 'pharmacy_admin';
    }

    // ========== PHARMACY IMAGES ==========
    // Public read for pharmacy logos and product images
    // Only the pharmacy owner (pharmacyId matches UID) or platform admins can upload
    match /pharmacies/{pharmacyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isImage()
                   && isValidFileSize()
                   && ((isPharmacyAdmin() && request.auth.uid == pharmacyId) || isAdmin());
      allow delete: if (isPharmacyAdmin() && request.auth.uid == pharmacyId) || isAdmin();
    }

    // ========== PRODUCT IMAGES ==========
    // Only pharmacy admins or platform admins can upload product images
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isImage()
                   && isValidFileSize()
                   && (isPharmacyAdmin() || isAdmin());
      allow delete: if isPharmacyAdmin() || isAdmin();
    }

    // ========== USER PROFILE IMAGES ==========
    // Only the owner can upload; authenticated users can view
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
                   && isImage()
                   && isValidFileSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ========== VERIFICATION DOCUMENTS ==========
    // Only the owner can upload; only the owner and admins can read
    // These contain sensitive PII (licenses, government IDs, CAC certificates)
    match /verification/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId)
                   && isDocument()
                   && isValidFileSize();
      allow delete: if isAdmin();
    }

    // ========== CHAT ATTACHMENTS ==========
    // Only authenticated users can upload (file size enforced)
    // Note: Conversation membership is validated server-side via Socket.IO;
    // Storage rules cannot cross-reference Firestore conversation docs.
    // Read restricted to authenticated users; write restricted to authenticated + size limit.
    match /chat/{conversationId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isValidFileSize()
                   && (isImage() || request.resource.contentType == 'application/pdf');
      allow delete: if isAdmin();
    }

    // ========== DEFAULT DENY ==========
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
